{
  "name": "aws-ssm-params-to-env",
  "version": "1.0.2",
  "description": "A github action to Convert SSM parameters to environment variables with support for JSON parameters",
  "exports": {
    ".": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "bundle": "pnpm run format:write && pnpm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 pnpx jest",
    "coverage": "pnpx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "pnpx prettier --write .",
    "format:check": "pnpx prettier --check .",
    "lint": "pnpx eslint .",
    "local-action": "pnpx @github/local-action . src/main.ts .env",
    "package": "pnpx rimraf ./dist && pnpx rollup --config rollup.config.ts",
    "package:watch": "pnpm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 pnpx jest",
    "all": "pnpm run format:write && pnpm run lint && pnpm run test && pnpm run coverage && pnpm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hausofweb/actions-aws-ssm-params-to-env.git"
  },
  "keywords": [
    "actions"
  ],
  "author": "Haus of Web",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hausofweb/actions-aws-ssm-params-to-env/issues"
  },
  "homepage": "https://github.com/hausofweb/actions-aws-ssm-params-to-env#readme",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.1018.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.3.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.15.21",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.8.1",
    "rollup": "^4.60.0",
    "ts-jest": "^29.4.6",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
